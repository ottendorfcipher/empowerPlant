# EmpowerPlant Backend Environment Variables
# Copy this file to .env and update the values as needed

# Database Configuration
DATABASE_URL=mysql://root:YOUR_PASSWORD_HERE@localhost:3306/empowerplant

# Server Configuration
HOST=127.0.0.1
PORT=8080

# JWT Secret (generate a secure random string)
JWT_SECRET=your-super-secure-jwt-secret-key-here

# Arduino Serial Port (update based on your system)
ARDUINO_PORT=/dev/ttyUSB0

# Weather API (optional - get free API key from OpenWeatherMap)
WEATHER_API_KEY=your-weather-api-key-here

# Log Level
RUST_LOG=debug
