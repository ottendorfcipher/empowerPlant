# Database Configuration
DATABASE_URL=mysql://empowerplant:empowerpass123@localhost:3306/empowerplant

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Kafka Configuration
KAFKA_BROKERS=localhost:9092

# Application Configuration
HOST=0.0.0.0
PORT=8081
PLANT_MONITORING_PORT=8082

# External APIs
# Get your OpenWeatherMap API key from: https://openweathermap.org/api
# Sign up for free and replace 'your_api_key_here' with your actual key
OPENWEATHER_API_KEY=your_api_key_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRY=3600

# Logging
RUST_LOG=info

# SQLx Configuration (for compile-time checks)
# SQLX_OFFLINE=true
